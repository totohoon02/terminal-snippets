
# ==========================================
# Git Utilities
# ==========================================

# .gitignore 템플릿 다운로드
ignore() {
    if [ "$#" -ne 1 ] || [ -z "$1" ]; then
        echo "Usage: ignore <language>"
        return 1
    fi

    local language="${1,,}"
    local url=""
    local tmp_file

    case "$language" in
        spring)
            url="https://raw.githubusercontent.com/spring-projects/spring-framework/refs/heads/main/.gitignore"
            ;;
        fastapi)
            url="https://raw.githubusercontent.com/fastapi/fastapi/refs/heads/master/.gitignore"
            ;;
        *)
            language="${language^}"
            url="https://raw.githubusercontent.com/github/gitignore/refs/heads/main/${language}.gitignore"
            ;;
    esac

    tmp_file=$(mktemp) || return 1

    if curl -fLsS "$url" -o "$tmp_file"; then
        mv "$tmp_file" .gitignore
        echo ".gitignore updated: $language"
    else
        rm -f "$tmp_file"
        echo "Failed to download .gitignore: $language"
        return 1
    fi
}

# ==========================================
# Gerrit Push
# ==========================================

# gp        -> develop
# gp br     -> br
gp() {
    if [ "$#" -gt 1 ]; then
        echo "Usage: gp [target-branch]"
        return 1
    fi

    local target="${1:-develop}"
    git push origin "HEAD:refs/for/$target"
}

# ==========================================
# Rebase All Local Branches
# ==========================================


rball() {
    local current_branch
    local branch
    local stash_ref=""
    local stash_entry=""
    local failed=0
    local cleanup_failed=0
    local git_dir

    # 1. Git 저장소 및 현재 브랜치 확인
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
        echo "[error] Not a Git repository"
        return 1
    }

    current_branch=$(git symbolic-ref --quiet --short HEAD) || {
        echo "[error] Detached HEAD is not supported"
        return 1
    }

    # 2. 진행 중인 Git 작업 확인
    if [ -d "$(git rev-parse --git-path rebase-merge)" ] ||
       [ -d "$(git rev-parse --git-path rebase-apply)" ] ||
       [ -f "$(git rev-parse --git-path MERGE_HEAD)" ] ||
       [ -f "$(git rev-parse --git-path CHERRY_PICK_HEAD)" ]; then
        echo "[error] An unfinished Git operation exists"
        return 1
    fi

    # 3. 추적 파일의 변경 사항만 Stash
    # Untracked 파일은 건드리지 않음
    if ! git diff --quiet || ! git diff --cached --quiet; then
        echo "[stash] Saving tracked changes"

        git stash push -m "rball-auto-stash" || {
            echo "[error] Stash failed"
            return 1
        }

        stash_ref=$(git rev-parse refs/stash) || return 1
    fi

    # 4. 복구 함수
    # 충돌 시 리베이스 취소 후 원래 브랜치로 복귀
    rball_cleanup() {
        local result=0

        if [ -d "$(git rev-parse --git-path rebase-merge)" ] ||
           [ -d "$(git rev-parse --git-path rebase-apply)" ]; then
            echo "[rebase] Aborting failed rebase"

            git rebase --abort || {
                echo "[error] Rebase abort failed"
                return 1
            }
        fi

        echo "[checkout] Returning to $current_branch"

        git switch "$current_branch" || {
            echo "[error] Failed to restore original branch"
            return 1
        }

        # 이번 실행에서 생성한 Stash만 복원
        if [ -n "$stash_ref" ]; then
            echo "[stash] Restoring tracked changes"

            if git stash apply --index "$stash_ref"; then
                stash_entry=$(git stash list --format='%gd %H' |
                    awk -v hash="$stash_ref" '$2 == hash {print $1; exit}')

                if [ -n "$stash_entry" ]; then
                    git stash drop "$stash_entry" || result=1
                fi
            else
                echo "[error] Stash restore failed"
                echo "[info] Stash preserved: $stash_ref"
                result=1
            fi
        fi

        return "$result"
    }

    # 5. 원격 정보 갱신 (1회)
    echo "[fetch] origin"

    if ! git fetch origin; then
        echo "[error] Fetch failed"
        rball_cleanup
        return 1
    fi

    # 6. develop 브랜치 갱신
    if git show-ref --verify --quiet refs/heads/develop; then
        echo "----------------------------------------"
        echo "[checkout] develop"

        if ! git switch develop; then
            echo "[error] Checkout develop failed"
            rball_cleanup
            return 1
        fi

        echo "[rebase] develop -> origin/develop"

        if ! git rebase origin/develop; then
            echo "[error] Develop rebase failed"
            rball_cleanup
            return 1
        fi
    fi

    # 7. 나머지 로컬 브랜치 순회
    while IFS= read -r branch; do
        case "$branch" in
            main|master|develop)
                continue
                ;;
        esac

        echo "----------------------------------------"
        echo "[checkout] $branch"

        if ! git switch "$branch"; then
            echo "[error] Checkout failed: $branch"
            failed=1
            break
        fi

        echo "[rebase] $branch -> origin/develop"

        if ! git rebase origin/develop; then
            echo "[error] Rebase failed: $branch"
            failed=1
            break
        fi

    done < <(git for-each-ref \
        --format='%(refname:short)' refs/heads)

    # 8. 원래 브랜치 및 변경 사항 복원
    if ! rball_cleanup; then
        echo "[error] Cleanup failed"
        cleanup_failed=1
    fi

    if [ "$failed" -ne 0 ] || [ "$cleanup_failed" -ne 0 ]; then
        echo "[error] rball stopped"
        return 1
    fi

    echo "----------------------------------------"
    echo "[success] rball completed"
}


gco() {
    local branch="$1"

    if [ -z "$branch" ]; then
        echo "Usage: gco <branch>"
        return 1
    fi

    if git show-ref --verify --quiet "refs/heads/$branch"; then
        git switch "$branch"
    else
        git switch -c "$branch"
    fi
}

# ==========================================
# Branch Aliases
# ==========================================

alias gbl="git branch -l"
alias gbd="git branch -d"
alias gcod="git checkout develop"
alias gcood="git checkout origin/develop"

# ==========================================
# Reset
# ==========================================

# 마지막 커밋 취소 (변경 사항은 staging에 유지)
alias sorry="git reset --soft HEAD~1"
