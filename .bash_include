source ~/terminal-snippets/.bash_snippet
source ~/terminal-snippets/.coding_test_snippet
source ~/terminal-snippets/.docker_snippet
source ~/terminal-snippets/.git_snippet
source ~/terminal-snippets/.python_snippet
source ~/terminal-snippets/.java_snippet
source ~/terminal-snippets/.k8s_snippet
source ~/terminal-snippets/.ai_snippet


function list() {
    local owner="totohoon02"
    local repo="terminal-snippets"
    local base_url="https://api.github.com/repos/$owner/$repo/contents"
    local target="$1"

    # 인자가 있으면 해당 파일만 조회
    if [[ -n "$target" ]]; then
        target=".${target}_snippet"
    fi

    # 파일 목록 가져오기
    local files
    files=$(curl -fsSL "$base_url") || return 1

    echo "$files" | grep -E '"name":|"download_url":' | sed 's/[",]//g' |
    while read -r line; do
        if [[ $line == *name:* ]]; then
            current_name=$(echo "$line" | awk '{print $2}')

        elif [[ $line == *download_url:* ]]; then
            current_url=$(echo "$line" | awk '{print $2}')

            # 제외 파일
            if [[ "$current_name" == ".bash_include" ||
                  "$current_name" == "README.md" ]]; then
                continue
            fi

            # 인자가 있으면 해당 파일만 조회
            if [[ -n "$target" && "$current_name" != "$target" ]]; then
                continue
            fi

            echo "### $current_name"

            # Alias는 전체 출력, Function은 이름만 출력
            curl -fsSL "$current_url" | tr -d '\r' | awk '
                BEGIN { count = 0; }

                # Alias
                /^[[:space:]]*alias[[:space:]]+/ {
                    count++;
                    print count ". " $0;
                    next;
                }

                # Function
                /^[[:space:]]*(function[[:space:]]+)?[[:alnum:]_-]+[[:space:]]*\(\)/ ||
                /^[[:space:]]*function[[:space:]]+[[:alnum:]_-]+/ {
                    count++;
                    name = $0;
                    sub(/^[[:space:]]*function[[:space:]]+/, "", name);
                    sub(/[[:space:]]*\(.*/, "", name);
                    sub(/[[:space:]]*\{.*/, "", name);
                    gsub(/[[:space:]]/, "", name);

                    print count ". " name;
                }
            '
            echo ""
        fi
    done
}

